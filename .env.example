# Copy to .env (gitignored). Read by the server only; nothing here reaches the phone.

# live = send photos to OpenAI; mock = canned readings from fixtures/vision. Defaults to live when a key is set.
VISION_MODE=live
OPENAI_API_KEY=
# Optional: model and its USD price per million tokens (defaults: gpt-6.2-sol at 2 / 10; gpt-6.2-astra is 8 / 40)
OPENAI_VISION_MODEL=
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=

# Optional: eBay Browse API for resale prices. Without it, the starter catalog is used.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
