# Copy to .env (gitignored). Read by the server only; nothing here reaches the phone.

# live = send photos to OpenAI; mock = canned readings from fixtures/vision. Defaults to live when a key is set.
VISION_MODE=live
OPENAI_API_KEY=
# Optional: model and its USD price per million tokens (defaults: gpt-6.2-sol at 2 / 10; gpt-6.2-astra is 8 / 40)
OPENAI_VISION_MODEL=
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=

# Optional: reasoning effort for the vision model (none | minimal | low | medium). Default low; a value the model refuses falls back to low.
OPENAI_REASONING_EFFORT=
# Optional: stop AI calls once this many USD have been spent today (UTC). Default 5. Barcodes, Read sticker and hardware reports keep working.
AI_DAILY_BUDGET_USD=

# Optional: eBay Browse API for resale prices. Without it, the starter catalog is used.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Postgres (Neon). Without it: local SQLite on this machine, in-memory on Vercel (data can vanish between requests).
# `neon deploy` writes this into .env.local; copy the same value into Vercel's environment variables.
DATABASE_URL=
# Optional: run the store contract tests against a throwaway Neon branch too
TEST_DATABASE_URL=

# Optional sign-in: when TEAM_PASSCODE is set, every tech signs in with their name and this passcode.
TEAM_PASSCODE=
# Signs the sign-in cookie; any long random string. Falls back to TEAM_PASSCODE if empty.
SESSION_SECRET=
