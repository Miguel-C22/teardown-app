{
  "name": "teardown-poc",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Teardown Scanner proof of concept: standalone, throwaway storage, CSV out only.",
  "scripts": {
    "dev": "tsx server/src/main.ts",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx server/src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "vision:eval": "tsx scripts/vision-eval.ts"
  },
  "dependencies": {
    "@neon/config": "^1.14.4",
    "@neon/env": "^2.1.7",
    "@neondatabase/serverless": "^1.2.1",
    "express": "^4.21.2",
    "openai": "^7.60.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "selfsigned": "^2.4.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7",
    "zxing-wasm": "^3.1.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
